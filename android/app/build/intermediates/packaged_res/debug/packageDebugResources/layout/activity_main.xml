<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView con la aplicación -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay de pantalla negra (se activa al detectar screenshot) -->
    <FrameLayout
        android:id="@+id/blackoutOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/black" />

    <!-- MARCA DE AGUA PERMANENTE - Siempre visible durante el examen -->
    <!-- Aparece en CUALQUIER screenshot que se tome -->
    <TextView
        android:id="@+id/watermarkText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="⚠️ CAPTURA DE PANTALLA NO PERMITIDA ⚠️\nEvaluación Protegida - Neurociencias UDP"
        android:textColor="#60FF0000"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:rotation="-25"
        android:lineSpacingExtra="15dp" />

</FrameLayout>